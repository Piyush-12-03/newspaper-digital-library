        </preConditions>
        <comment>Add Mumbai edition</comment>
        <insert tableName="editions">
            <column name="name" value="Mumbai City"/>
            <column name="slug" value="mumbai-city"/>
            <column name="city" value="Mumbai"/>
            <column name="state" value="Maharashtra"/>
            <column name="edition_type" value="CITY"/>
            <column name="active" valueBoolean="true"/>
        </insert>
    </changeSet>
    -->

</databaseChangeLog>
