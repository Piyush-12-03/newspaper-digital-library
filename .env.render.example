# Render Environment Variables Configuration
# Copy these to Render Dashboard → Environment tab

# Application Profile (use 'dev' for development deployment, 'prod' for production)
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Your Render PostgreSQL)
# Get these from Render Dashboard → Database → Connection String
DB_URL=jdbc:postgresql://YOUR-RENDER-DB-HOST:5432/YOUR-DB-NAME
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT Configuration (IMPORTANT: Generate a new secure secret!)
# Generate with: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_256_BITS

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=e-newspaper-library-local
AWS_REGION=us-east-1

# Optional: Override defaults
# DDL_AUTO=none
# LIQUIBASE_ENABLED=true
